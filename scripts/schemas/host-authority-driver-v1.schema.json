{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/conformance/host-authority-driver-v1.schema.json",
  "type": "object",
  "required": ["format", "schema_version", "specification_commit", "operations", "profiles", "clocks", "worker_checks", "native_traces", "allocation_checks", "base_core_checks", "unclaimed_guarantee_checks", "production_scenarios", "transfer_suite_obligation"],
  "properties": {
    "format": {"const": "determa.host-authority-driver-v1"},
    "schema_version": {"const": 1},
    "specification_commit": {"const": "86bb88dd21cb1f799eefe5020b6e49dabf6e7225"},
    "operations": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"$ref": "#/$defs/operation"}},
    "profiles": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/profile"}},
    "clocks": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/clock"}},
    "worker_checks": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/workerCheck"}},
    "native_traces": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/nativeTrace"}},
    "allocation_checks": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/allocationCheck"}},
    "base_core_checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/baseCoreCheck"}},
    "unclaimed_guarantee_checks": {"type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/unclaimedGuaranteeCheck"}},
    "production_scenarios": {"type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/productionScenario"}},
    "transfer_suite_obligation": {"type": "object", "required": ["profile", "certified_by_this_profile", "required_suite", "required_native_observations"],
      "properties": {"profile": {"const": "safe_relocation"}, "certified_by_this_profile": {"const": false},
        "required_suite": {"type": "string"}, "required_native_observations": {"type": "array", "minItems": 7,
          "maxItems": 7, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false,
  "$defs": {
    "ledger": {
      "type": "object",
      "required": ["allocated_scope_identities", "scope_identity", "owner_principal", "authority_epoch", "scope_generation", "state", "receipts", "mutation_bytes", "checkpoint_bytes", "journal_entries", "ingress_acknowledgements", "active_claims", "roots", "tombstones", "pending_intents", "terminal_intents", "definition_references", "migration_references", "required_participant_records", "freeze", "inventory", "retirement_grants", "destination_activations"],
      "properties": {
        "allocated_scope_identities": {"type": "array", "items": {"type": "string"}},
        "scope_identity": {"type": "string"}, "owner_principal": {"type": "string"},
        "authority_epoch": {"type": "string"}, "scope_generation": {"type": "string"},
        "state": {"enum": ["active", "freezing", "frozen", "retired", "transaction_in_doubt"]},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}},
        "mutation_bytes": {"type": "array", "items": {"type": "string"}},
        "checkpoint_bytes": {"type": "array", "items": {"type": "string"}},
        "journal_entries": {"type": "array", "items": {"type": "object"}},
        "ingress_acknowledgements": {"type": "array", "items": {"type": "object"}},
        "active_claims": {"type": "array", "items": {"type": "object"}},
        "roots": {"type": "array", "items": {"type": "string"}},
        "tombstones": {"type": "array", "items": {"type": "string"}},
        "pending_intents": {"type": "array", "items": {"type": "string"}},
        "terminal_intents": {"type": "array", "items": {"type": "string"}},
        "definition_references": {"type": "array", "items": {"type": "string"}},
        "migration_references": {"type": "array", "items": {"type": "string"}},
        "required_participant_records": {"type": "array", "items": {"type": "string"}},
        "freeze": {"type": ["object", "null"]},
        "inventory": {"type": "array", "items": {"type": "object"}},
        "retirement_grants": {"type": "array", "items": {"type": "object"}},
        "destination_activations": {"type": "array", "items": {"type": "object"}}
      }, "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["operation_id", "request_digest", "request_bytes", "result_bytes", "evidence_digest"],
      "properties": {
        "operation_id": {"type": "string"}, "request_digest": {"type": "string"},
        "request_bytes": {"type": "string"}, "result_bytes": {"type": ["string", "null"]},
        "evidence_digest": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["id", "source_disposition", "execution_tier", "request", "request_bytes", "expected_response", "expected_response_bytes", "invocation", "native_mutation_bytes", "ledger_before", "ledger_after", "fault", "replay_of", "configuration"],
      "properties": {
        "id": {"type": "string"}, "source_disposition": {"enum": ["valid", "rejected"]},
        "execution_tier": {"enum": ["native_c", "i2_conditional"]},
        "request": {"type": "object"}, "request_bytes": {"type": "string"},
        "expected_response": {"type": "object"}, "expected_response_bytes": {"type": "string"},
        "invocation": {"type": "object"}, "native_mutation_bytes": {"type": ["string", "null"]},
        "ledger_before": {"$ref": "#/$defs/ledger"}, "ledger_after": {"$ref": "#/$defs/ledger"},
        "fault": {"type": "object", "required": ["native_transaction_fate", "injection", "epoch_check_separate_from_commit"],
          "properties": {"native_transaction_fate": {"enum": ["known", "committed", "unknown"]},
            "injection": {"enum": ["none", "disconnect_before_fate_resolution"]},
            "epoch_check_separate_from_commit": {"type": "boolean"}}, "additionalProperties": false},
        "replay_of": {"type": ["string", "null"]},
        "configuration": {"type": "object"}
      }, "additionalProperties": false
    },
    "profile": {
      "type": "object", "required": ["id", "source_disposition", "fixture_layer", "submitted_report", "hypothetical_verification", "configured_facts", "expected_report", "expected_report_bytes", "expected_outcome", "expected_support"],
      "properties": {"id": {"type": "string"}, "source_disposition": {"enum": ["valid", "invalid"]},
        "fixture_layer": {"const": "hypothetical_common_rule"},
        "hypothetical_verification": {"type": ["object", "null"]},
        "submitted_report": {"type": "object"},
        "configured_facts": {"type": "object"}, "expected_report": {"type": "object"},
        "expected_report_bytes": {"type": "string"}, "expected_outcome": {"type": "object"},
        "expected_support": {"type": ["object", "null"]}},
      "additionalProperties": false
    },
    "clock": {
      "type": "object", "required": ["id", "source_disposition", "value"],
      "properties": {"id": {"type": "string"}, "source_disposition": {"enum": ["valid", "invalid"]},
        "value": {"type": "string"}}, "additionalProperties": false
    },
    "workerCheck": {
      "type": "object", "required": ["id", "input", "expected"],
      "properties": {"id": {"type": "string"}, "input": {"type": "object"},
        "expected": {"type": "object", "required": ["accepted", "ledger_after", "host_mutation_count", "external_dispatch_count"],
          "properties": {"accepted": {"type": "boolean"}, "ledger_after": {"$ref": "#/$defs/ledger"},
            "host_mutation_count": {"type": "integer", "minimum": 0},
            "external_dispatch_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
      "additionalProperties": false
    },
    "nativeTrace": {
      "type": "object", "required": ["id", "required_guarantee", "setup", "steps", "control_plan", "expected_events"],
      "properties": {"id": {"type": "string"}, "required_guarantee": {"type": "string"},
        "setup": {"$ref": "#/$defs/ledger"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nativeStep"}},
        "control_plan": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/nativeControl"}},
        "expected_events": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/nativeEvent"}}},
      "additionalProperties": false
    },
    "nativeControl": {
      "type": "object", "required": ["action", "session", "step", "barrier"],
      "properties": {"action": {"enum": ["invoke", "start_call", "release_barrier", "observe_native_fate", "observe_storage", "restart_authority", "disconnect_session", "resolve_fate_from_storage", "fence_old_session"]},
        "session": {"type": ["string", "null"]}, "step": {"type": ["integer", "null"]},
        "barrier": {"type": ["string", "null"]}}, "additionalProperties": false
    },
    "nativeEvent": {
      "type": "object", "required": ["event", "session", "response_bytes", "ledger", "fate", "barrier", "old_session_fenced"],
      "properties": {"event": {"enum": ["response", "native_fate", "storage", "restarted", "barrier_reached", "old_session_fenced"]},
        "session": {"type": ["string", "null"]}, "response_bytes": {"type": ["string", "null"]},
        "ledger": {"anyOf": [{"$ref": "#/$defs/ledger"}, {"type": "null"}]},
        "fate": {"enum": ["unknown", "committed", "rolled_back", null]},
        "barrier": {"type": ["string", "null"]}, "old_session_fenced": {"type": ["boolean", "null"]}},
      "additionalProperties": false
    },
    "nativeStep": {
      "type": "object", "required": ["call", "expected_response_bytes", "expected_ledger_after"],
      "properties": {"call": {"type": "object", "required": ["request_bytes", "invocation", "native_mutation_bytes", "fault"],
          "properties": {"request_bytes": {"type": "string"}, "invocation": {"type": "object"},
            "native_mutation_bytes": {"type": ["string", "null"]},
            "fault": {"enum": ["none", "precommit_abort", "drop_response_after_commit",
                                "commit_unknown_disconnect", "omit_receipt_from_inventory"]}},
          "additionalProperties": false},
        "expected_response_bytes": {"type": ["string", "null"]},
        "expected_ledger_after": {"$ref": "#/$defs/ledger"}},
      "additionalProperties": false
    },
    "allocationCheck": {
      "type": "object", "required": ["id", "input", "expected"],
      "properties": {"id": {"type": "string"}, "input": {"type": "object"},
        "expected": {"type": "object"}}, "additionalProperties": false
    },
    "baseCoreCheck": {
      "type": "object", "required": ["id", "input", "expected"],
      "properties": {"id": {"type": "string"}, "input": {"type": "object"},
        "expected": {"type": "object"}}, "additionalProperties": false
    },
    "unclaimedGuaranteeCheck": {
      "type": "object", "required": ["id", "required_guarantee", "request_bytes", "invocation",
        "native_mutation_bytes", "fault", "ledger_before", "expected_response_bytes", "ledger_after",
        "effects_before", "effects_after"],
      "properties": {"id": {"type": "string"},
        "required_guarantee": {"enum": ["guarded_local_writes", "worker_fencing", "safe_relocation"]},
        "request_bytes": {"type": "string"}, "invocation": {"type": "object"},
        "native_mutation_bytes": {"type": ["string", "null"]}, "fault": {"type": "object"},
        "ledger_before": {"$ref": "#/$defs/ledger"}, "ledger_after": {"$ref": "#/$defs/ledger"},
        "expected_response_bytes": {"type": "string"},
        "effects_before": {"$ref": "#/$defs/effects"},
        "effects_after": {"$ref": "#/$defs/effects"}}, "additionalProperties": false
    },
    "effects": {"type": "object", "required": ["host_mutation_count", "external_dispatch_count",
      "core_call_count", "claim_allocation_count"],
      "properties": {"host_mutation_count": {"type": "integer", "minimum": 0},
        "external_dispatch_count": {"type": "integer", "minimum": 0},
        "core_call_count": {"type": "integer", "minimum": 0},
        "claim_allocation_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "productionScenario": {
      "type": "object", "required": ["id", "applicability", "operations", "worker_checks", "native_traces", "allocation_check"],
      "properties": {"id": {"enum": ["guarded_sqlite", "worker_sqlite"]},
        "applicability": {"type": "object", "required": ["topology_identifier", "required_participants"],
          "properties": {"topology_identifier": {"type": "string"},
            "required_participants": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false},
        "operations": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/operation"}},
        "worker_checks": {"type": "array", "items": {"$ref": "#/$defs/workerCheck"}},
        "native_traces": {"type": "array", "minItems": 8, "maxItems": 8,
          "items": {"$ref": "#/$defs/nativeTrace"}},
        "allocation_check": {"$ref": "#/$defs/allocationCheck"}}, "additionalProperties": false
    }
  }
}
