{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/conformance/persistence-vectors.schema.json",
  "type": "object",
  "required": ["title", "static", "artifacts", "persistence_vectors"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "static": {
      "$ref": "#/$defs/staticAssertions"
    },
    "artifacts": {
      "$ref": "#/$defs/artifactManifest"
    },
    "persistence_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "fileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(?:json|yaml)$"
    },
    "jsonFileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    },
    "staticAssertions": {
      "type": "object",
      "required": ["documents"],
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "valid"],
            "additionalProperties": false,
            "properties": {
              "file": {
                "$ref": "#/$defs/fileName"
              },
              "valid": {
                "type": "boolean"
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "valid": {
                      "const": false
                    }
                  },
                  "required": ["valid"]
                },
                "then": {
                  "required": ["error"]
                },
                "else": {
                  "not": {
                    "required": ["error"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "artifactManifest": {
      "type": "object",
      "required": ["documents"],
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "kind", "valid"],
            "additionalProperties": false,
            "properties": {
              "file": {
                "$ref": "#/$defs/jsonFileName"
              },
              "kind": {
                "enum": [
                  "aggregate_state",
                  "migration_descriptor",
                  "aggregate_state_package",
                  "artifact_resolver",
                  "resource_limits",
                  "json_value"
                ]
              },
              "valid": {
                "type": "boolean"
              },
              "error": {
                "type": "string",
                "minLength": 1
              },
              "canonical_of": {
                "$ref": "#/$defs/jsonFileName"
              },
              "verify_digest": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "valid": {
                      "const": false
                    }
                  },
                  "required": ["valid"]
                },
                "then": {
                  "required": ["error"],
                  "not": {
                    "required": ["canonical_of"]
                  }
                },
                "else": {
                  "not": {
                    "required": ["error"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "expectation": {
      "type": "object",
      "required": ["result"],
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": ["success", "failure"]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_state_file": {
          "$ref": "#/$defs/jsonFileName"
        },
        "exact_bytes_file": {
          "$ref": "#/$defs/jsonFileName"
        },
        "migration_audit_file": {
          "$ref": "#/$defs/jsonFileName"
        },
        "emissions_file": {
          "$ref": "#/$defs/jsonFileName"
        },
        "artifact_resolver_file": {
          "$ref": "#/$defs/jsonFileName"
        },
        "disposition": {
          "enum": ["handled", "unhandled", "rejected", "faulted"]
        },
        "caller_still_owns_aggregate": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "failure"
              }
            },
            "required": ["result"]
          },
          "then": {
            "required": ["code", "caller_still_owns_aggregate"],
            "not": {
              "anyOf": [
                {
                  "required": ["aggregate_state_file"]
                },
                {
                  "required": ["exact_bytes_file"]
                },
                {
                  "required": ["migration_audit_file"]
                },
                {
                  "required": ["emissions_file"]
                },
                {
                  "required": ["artifact_resolver_file"]
                },
                {
                  "required": ["disposition"]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["code"]
                },
                {
                  "required": ["caller_still_owns_aggregate"]
                }
              ]
            }
          }
        }
      ]
    },
    "aggregateBytesSuccess": {
      "if": {
        "properties": {
          "result": {
            "const": "success"
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": ["aggregate_state_file", "exact_bytes_file"],
        "not": {
          "anyOf": [
            {
              "required": ["migration_audit_file"]
            },
            {
              "required": ["emissions_file"]
            },
            {
              "required": ["artifact_resolver_file"]
            },
            {
              "required": ["disposition"]
            }
          ]
        }
      }
    },
    "migrationSuccess": {
      "if": {
        "properties": {
          "result": {
            "const": "success"
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": [
          "aggregate_state_file",
          "exact_bytes_file",
          "migration_audit_file"
        ],
        "not": {
          "anyOf": [
            {
              "required": ["emissions_file"]
            },
            {
              "required": ["artifact_resolver_file"]
            },
            {
              "required": ["disposition"]
            }
          ]
        }
      }
    },
    "dispatchSuccess": {
      "if": {
        "properties": {
          "result": {
            "const": "success"
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": [
          "aggregate_state_file",
          "exact_bytes_file",
          "emissions_file",
          "disposition"
        ],
        "not": {
          "anyOf": [
            {
              "required": ["migration_audit_file"]
            },
            {
              "required": ["artifact_resolver_file"]
            }
          ]
        }
      }
    },
    "migrationDispatchSuccess": {
      "if": {
        "properties": {
          "result": {
            "const": "success"
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": [
          "aggregate_state_file",
          "exact_bytes_file",
          "migration_audit_file",
          "emissions_file",
          "disposition"
        ],
        "not": {
          "required": ["artifact_resolver_file"]
        }
      }
    },
    "packageMigrationSuccess": {
      "if": {
        "properties": {
          "result": {
            "const": "success"
          }
        },
        "required": ["result"]
      },
      "then": {
        "required": [
          "aggregate_state_file",
          "exact_bytes_file",
          "migration_audit_file",
          "artifact_resolver_file"
        ],
        "not": {
          "anyOf": [
            {
              "required": ["emissions_file"]
            },
            {
              "required": ["disposition"]
            }
          ]
        }
      }
    },
    "vector": {
      "type": "object",
      "required": ["name", "operation", "expect"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "operation": {
          "enum": [
            "serialize_created_aggregate",
            "restore_and_serialize",
            "restore_and_dispatch",
            "restore_package",
            "restore_package_and_migrate",
            "migrate_aggregate",
            "migrate_and_dispatch"
          ]
        },
        "source_bundle": {
          "$ref": "#/$defs/fileName"
        },
        "creation": {
          "type": "object",
          "required": ["machine_id", "root_instance_id", "creation_id", "bindings"],
          "additionalProperties": false,
          "properties": {
            "machine_id": {
              "type": "string",
              "minLength": 1
            },
            "root_instance_id": {
              "type": "string",
              "minLength": 1
            },
            "creation_id": {
              "type": "string",
              "minLength": 1
            },
            "bindings": {
              "type": "object"
            }
          }
        },
        "target_bundle": {
          "$ref": "#/$defs/fileName"
        },
        "aggregate_state": {
          "$ref": "#/$defs/jsonFileName"
        },
        "aggregate_state_package": {
          "$ref": "#/$defs/jsonFileName"
        },
        "definitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fileName"
          }
        },
        "migration_descriptors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jsonFileName"
          }
        },
        "migration_route": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "target_validated_bundle_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "maintenance_mode": {
          "type": "boolean"
        },
        "migration_request": {
          "type": "object",
          "required": [
            "target_validated_bundle_fingerprint",
            "migration_route"
          ],
          "additionalProperties": false,
          "properties": {
            "target_validated_bundle_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "migration_route": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "maintenance_mode": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "const": "not-a-boolean"
                }
              ]
            }
          }
        },
        "input_envelope": {
          "$ref": "#/$defs/jsonFileName"
        },
        "resource_limits": {
          "$ref": "#/$defs/jsonFileName"
        },
        "artifact_resolver": {
          "$ref": "#/$defs/jsonFileName"
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 2
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["migrate_aggregate", "migrate_and_dispatch"]
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": [
              "aggregate_state",
              "definitions",
              "migration_descriptors"
            ],
            "oneOf": [
              {
                "required": [
                  "migration_route",
                  "target_validated_bundle_fingerprint",
                  "maintenance_mode"
                ],
                "not": {
                  "required": ["migration_request"]
                }
              },
              {
                "required": ["migration_request"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["migration_route"]
                    },
                    {
                      "required": ["target_validated_bundle_fingerprint"]
                    },
                    {
                      "required": ["maintenance_mode"]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "migrate_aggregate"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "expect": {
                "$ref": "#/$defs/migrationSuccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "migrate_and_dispatch"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": ["input_envelope"],
            "properties": {
              "expect": {
                "$ref": "#/$defs/migrationDispatchSuccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "restore_package"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": ["aggregate_state_package"],
            "properties": {
              "expect": {
                "$ref": "#/$defs/aggregateBytesSuccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "restore_package_and_migrate"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": [
              "aggregate_state_package",
              "artifact_resolver",
              "migration_route",
              "target_validated_bundle_fingerprint",
              "maintenance_mode"
            ],
            "properties": {
              "expect": {
                "$ref": "#/$defs/packageMigrationSuccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "restore_and_serialize",
                  "restore_and_dispatch"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": ["aggregate_state", "definitions"]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "restore_and_serialize"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "expect": {
                "$ref": "#/$defs/aggregateBytesSuccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "restore_and_dispatch"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": ["input_envelope"],
            "properties": {
              "expect": {
                "$ref": "#/$defs/dispatchSuccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "serialize_created_aggregate"
              }
            },
            "required": ["operation"]
          },
          "then": {
            "required": ["source_bundle", "creation"],
            "properties": {
              "expect": {
                "$ref": "#/$defs/aggregateBytesSuccess"
              }
            }
          }
        }
      ]
    }
  }
}
