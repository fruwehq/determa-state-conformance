{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/conformance/execution-store-scope-state.schema.json",
  "type": "object",
  "required": [
    "execution_store_scope_state_format",
    "execution_store_scope_state_schema_version",
    "snapshots"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_store_scope_state_format": {
      "const": "determa.execution_checkpoint_profile.store_scope_state"
    },
    "execution_store_scope_state_schema_version": { "const": 1 },
    "snapshots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/snapshot" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpointBinding": {
      "type": "object",
      "required": ["file", "serialization_digest", "execution_checkpoint_digest"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "serialization_digest": { "$ref": "#/$defs/sha256" },
        "execution_checkpoint_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "outboxRecordBinding": {
      "type": "object",
      "required": [
        "effect_id",
        "record_kind",
        "source_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "effect_id": { "$ref": "#/$defs/sha256" },
        "record_kind": { "enum": ["pending", "terminal", "tombstone"] },
        "source_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "logical_scope_id",
        "physical_isolation_key",
        "checkpoints",
        "outbox_records"
      ],
      "additionalProperties": false,
      "properties": {
        "logical_scope_id": { "$ref": "#/$defs/nonEmptyString" },
        "physical_isolation_key": { "$ref": "#/$defs/nonEmptyString" },
        "checkpoints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
          "additionalProperties": { "$ref": "#/$defs/checkpointBinding" }
        },
        "outbox_records": {
          "type": "array",
          "items": { "$ref": "#/$defs/outboxRecordBinding" }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["physical_backend_id", "scopes"],
      "additionalProperties": false,
      "properties": {
        "physical_backend_id": { "$ref": "#/$defs/nonEmptyString" },
        "scopes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/scope" }
        }
      }
    }
  }
}
