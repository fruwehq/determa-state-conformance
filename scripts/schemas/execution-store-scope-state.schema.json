{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/conformance/execution-store-scope-state.schema.json",
  "type": "object",
  "required": [
    "execution_store_scope_state_format",
    "execution_store_scope_state_schema_version",
    "snapshots"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_store_scope_state_format": {
      "const": "determa.execution_checkpoint_profile.store_scope_state"
    },
    "execution_store_scope_state_schema_version": { "const": 1 },
    "snapshots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/snapshot" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpointBinding": {
      "type": "object",
      "required": ["file", "source_digest", "execution_checkpoint_digest"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "execution_checkpoint_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "outboxActivity": {
      "type": "object",
      "required": [
        "effect_id",
        "route_attempts",
        "retry_transitions",
        "reconciliation_transitions",
        "deduplication_hits",
        "deliveries",
        "broker_acknowledgements"
      ],
      "additionalProperties": false,
      "properties": {
        "effect_id": { "$ref": "#/$defs/sha256" },
        "route_attempts": { "$ref": "#/$defs/canonicalDecimal" },
        "retry_transitions": { "$ref": "#/$defs/canonicalDecimal" },
        "reconciliation_transitions": { "$ref": "#/$defs/canonicalDecimal" },
        "deduplication_hits": { "$ref": "#/$defs/canonicalDecimal" },
        "deliveries": { "$ref": "#/$defs/canonicalDecimal" },
        "broker_acknowledgements": { "$ref": "#/$defs/canonicalDecimal" }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "logical_scope_id",
        "physical_isolation_key",
        "owning_trust_domain",
        "checkpoints",
        "outbox_activity"
      ],
      "additionalProperties": false,
      "properties": {
        "logical_scope_id": { "$ref": "#/$defs/nonEmptyString" },
        "physical_isolation_key": { "$ref": "#/$defs/nonEmptyString" },
        "owning_trust_domain": { "$ref": "#/$defs/nonEmptyString" },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkpointBinding" }
        },
        "outbox_activity": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outboxActivity" }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["physical_backend_id", "scopes"],
      "additionalProperties": false,
      "properties": {
        "physical_backend_id": { "$ref": "#/$defs/nonEmptyString" },
        "scopes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/scope" }
        }
      }
    }
  }
}
