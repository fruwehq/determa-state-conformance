{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/conformance/runtime-provider-vectors.schema.json",
  "type": "object",
  "required": ["format", "version", "source_files", "source_closure_file", "normative_examples", "vectors"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "determa.runtime_provider_vectors"},
    "version": {"const": 1},
    "source_files": {"const": ["provider/test_provider.py", "provider/test_provider.rs"]},
    "source_closure_file": {"const": "provider-closure.json"},
    "normative_examples": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string"}},
    "vectors": {"type": "array", "minItems": 52, "maxItems": 52, "items": {"$ref": "#/$defs/vector"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "required": ["identifier", "version", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "version": {"const": "1.0.0"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "installed": {
      "type": "object", "required": ["mode", "providers", "closure_digest", "source_digest", "trusted"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "exact"},
        "providers": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "closure_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "trusted": {"type": "boolean"}
      }
    },
    "request": {
      "type": "object", "required": ["operation", "bundle", "installed", "setup", "arguments"],
      "additionalProperties": false,
      "properties": {
        "operation": {"enum": ["load", "step", "host_commit", "inspect", "create", "restore", "compile"]},
        "bundle": {"enum": ["machine.yaml", "machine-environment.yaml", "machine-mixed.yaml", "machine-safe.yaml", "machine-inert.yaml", "machine-final.yaml", "machine-final-control.yaml", "machine-local-write.yaml", "machine-choice-write.yaml", "machine-initial-write.yaml", "machine-initial-control.yaml", "norm-compiled-machine.json"]},
        "installed": {"$ref": "#/$defs/installed"},
        "setup": {"type": ["object", "null"], "required": ["create_request", "target_runtime_id", "envelope", "provider_snapshot"], "additionalProperties": false,
          "properties": {"create_request": {"type": "object"}, "target_runtime_id": {"$ref": "#/$defs/digest"}, "envelope": {"type": "object"}, "provider_snapshot": {"type": "object"}}},
        "arguments": {"type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {
            "opt_in_weak": {"type": "boolean"}, "approved": {"type": "boolean"},
            "native_selected": {"type": "boolean"}, "guard_override": {"type": "boolean"},
            "environment_send": {"enum": ["valid", "self", "unknown_component", "multiple", "correlation", "empty", "unknown_variable", "wrong_type"]},
            "repeat_send": {"type": "boolean"}, "mixed_send": {"type": "boolean"}, "replay": {"type": "boolean"}, "destroyed_write": {"type": "boolean"}, "capture_snapshot": {"type": "boolean"}, "invalid_output": {"type": "boolean"}, "action_fail": {"type": "boolean"},
            "action_external_io": {"type": "boolean"}, "cas_conflict": {"type": "boolean"},
            "maximum_attempts": {"type": "integer", "minimum": 1},
            "mode": {"enum": ["structural", "semantic"]},
            "maximum_guard_evaluations": {"type": "integer", "minimum": 0},
            "maximum_evaluation_steps": {"type": "integer", "minimum": 0},
            "definition_fingerprint": {"$ref": "#/$defs/digest"},
            "source_file": {"const": "source-package.json"},
            "manifest_file": {"const": "source-manifest.json"},
            "generated_bundle_file": {"const": "norm-compiled-machine.json"},
            "source_override": {"type": "string"},
            "source_digest_override": {"$ref": "#/$defs/digest"},
            "manifest_fingerprint_override": {"$ref": "#/$defs/digest"},
            "invalid_slot": {"enum": ["metadata_guard", "variable_action"]},
            "without_manifest": {"type": "boolean"}, "weak_compiler": {"type": "boolean"},
            "maximum_compilation_steps": {"type": "integer", "minimum": 0}
          }}
      }
    },
    "calls": {
      "type": "object", "required": ["guard", "actions", "inspect_guard", "compile_region", "external"],
      "additionalProperties": false,
      "properties": {
        "guard": {"type": "integer", "minimum": 0},
        "actions": {"type": "integer", "minimum": 0},
        "inspect_guard": {"type": "integer", "minimum": 0},
        "compile_region": {"type": "integer", "minimum": 0},
        "external": {"type": "integer", "minimum": 0}
      }
    },
    "capabilities": {
      "type": ["object", "null"],
      "required": ["deterministic", "pure", "portable", "semantically_introspectable", "process_contained", "external_io_capable"],
      "additionalProperties": false,
      "properties": {
        "deterministic": {"type": "boolean"}, "pure": {"type": "boolean"},
        "portable": {"type": "boolean"}, "semantically_introspectable": {"type": "boolean"},
        "process_contained": {"type": "boolean"}, "external_io_capable": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object",
      "required": ["stages", "result", "code", "value", "calls", "irreversible_side_effects", "external_effects", "determa_state_committed", "effective_capabilities", "state_before", "state_after"],
      "additionalProperties": false,
      "properties": {
        "stages": {"type": "array", "minItems": 1, "items": {"enum": ["resolve_closure", "create", "admit", "verify_capabilities", "load", "evaluate_cel", "evaluate_guard", "evaluate_actions", "validate_output", "commit", "deliver_env", "replay", "compare_and_swap", "preflight_inspection", "structural_inspection", "invoke_inspect_guard", "resolve_runtime_closure", "restore", "validate_source", "resolve_compiler_closure", "compile_region", "strict_load", "verify_manifest"]}},
        "result": {"enum": ["accepted", "rejected", "handled_now", "unhandled", "faulted", "uncommitted"]},
        "code": {"type": ["string", "null"]},
        "value": {"type": ["object", "null"]},
        "calls": {"$ref": "#/$defs/calls"},
        "irreversible_side_effects": {"type": "integer", "minimum": 0},
        "external_effects": {"type": "array", "items": {"type": "object", "required": ["effect_id", "kind", "phase"], "additionalProperties": false,
          "properties": {"effect_id": {"type": "string"}, "kind": {"const": "external_write"}, "phase": {"const": "before_commit"}}}},
        "determa_state_committed": {"type": "boolean"},
        "state_before": {"type": ["object", "null"]},
        "state_after": {"type": ["object", "null"]},
        "effective_capabilities": {"$ref": "#/$defs/capabilities"}
      }
    },
    "vector": {
      "type": "object", "required": ["name", "request", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "request": {"$ref": "#/$defs/request"},
        "expected": {"$ref": "#/$defs/observation"}
      }
    }
  }
}
