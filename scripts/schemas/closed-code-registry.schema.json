{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/schemas/conformance/closed-code-registry.schema.json",
  "$defs": {
    "category": {
      "enum": [
        "checkpoint_artifact_failure",
        "checkpoint_host_failure",
        "checkpoint_pre_acceptance_failure",
        "creation_rejection",
        "dispatch_rejection",
        "disposition",
        "engine_fault",
        "execution_store_adapter_failure",
        "execution_store_failure",
        "machine_load_failure",
        "persistence_failure"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_schema_version",
    "specification_version",
    "categories",
    "entries"
  ],
  "properties": {
    "registry_schema_version": {
      "const": 1
    },
    "specification_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "$ref": "#/$defs/category"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "code", "condition", "source"],
        "properties": {
          "category": {
            "$ref": "#/$defs/category"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
