{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/state/conformance/persistence-profile.schema.json",
  "type": "object",
  "required": ["title", "static", "artifacts", "persistence_profile"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "static": {
      "$ref": "persistence-vectors.schema.json#/$defs/staticAssertions"
    },
    "artifacts": {
      "$ref": "persistence-vectors.schema.json#/$defs/artifactManifest"
    },
    "persistence_profile": {
      "type": "object",
      "required": ["initial_store", "steps"],
      "additionalProperties": false,
      "properties": {
        "initial_store": {
          "$ref": "persistence-vectors.schema.json#/$defs/jsonFileName"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["operation", "expect_store", "expect_call_log"],
            "additionalProperties": false,
            "properties": {
              "operation": {
                "enum": [
                  "process",
                  "replay",
                  "inject_failure",
                  "release_quarantine"
                ]
              },
              "input_envelope": {
                "$ref": "persistence-vectors.schema.json#/$defs/jsonFileName"
              },
              "target_validated_bundle_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "migration_route": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "failure_boundary": {
                "enum": [
                  "after_artifact_resolution",
                  "after_transaction_begin",
                  "after_aggregate_staged",
                  "after_inbox_staged",
                  "after_outbox_staged",
                  "after_audit_staged",
                  "before_commit",
                  "after_commit_before_acknowledgement"
                ]
              },
              "failure_class": {
                "enum": ["transient", "permanent", "crash"]
              },
              "expect_store": {
                "$ref": "persistence-vectors.schema.json#/$defs/jsonFileName"
              },
              "expect_call_log": {
                "$ref": "persistence-vectors.schema.json#/$defs/jsonFileName"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operation": {
                      "enum": ["process", "release_quarantine"]
                    }
                  },
                  "required": ["operation"]
                },
                "then": {
                  "required": [
                    "input_envelope",
                    "target_validated_bundle_fingerprint",
                    "migration_route"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": ["failure_boundary"]
                      },
                      {
                        "required": ["failure_class"]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "replay"
                    }
                  },
                  "required": ["operation"]
                },
                "then": {
                  "required": ["input_envelope"],
                  "not": {
                    "anyOf": [
                      {
                        "required": ["target_validated_bundle_fingerprint"]
                      },
                      {
                        "required": ["migration_route"]
                      },
                      {
                        "required": ["failure_boundary"]
                      },
                      {
                        "required": ["failure_class"]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "inject_failure"
                    }
                  },
                  "required": ["operation"]
                },
                "then": {
                  "required": [
                    "input_envelope",
                    "target_validated_bundle_fingerprint",
                    "migration_route",
                    "failure_boundary",
                    "failure_class"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
