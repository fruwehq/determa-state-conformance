{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://determa.dev/schemas/conformance/application-projection-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "static",
    "artifacts",
    "application_projection_vectors"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "static": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "valid"
            ],
            "properties": {
              "file": {
                "enum": [
                  "machine.yaml",
                  "external-machine.yaml",
                  "deferral-machine.yaml",
                  "outbox-machine.yaml"
                ]
              },
              "valid": {
                "const": true
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "kind",
              "valid"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9-]+(?:-v1)?\\.json$"
              },
              "kind": {
                "enum": [
                  "execution_checkpoint_v1",
                  "application_projection_v1",
                  "aggregate_state_v1",
                  "core_step_result_v1"
                ]
              },
              "valid": {
                "const": true
              }
            }
          }
        }
      }
    },
    "application_projection_vectors": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
