format: 1
namespace: example.inspection_provider

events:
  safe: { direction: input }
  unsafe: { direction: input }
  mixed: { direction: input }

machines:
  - machine_id: inspector
    root:
      type: composite
      initial: { transition_to: waiting }
      states:
        waiting:
          on_events:
            safe:
              guard:
                provider:
                  provider_reference:
                    identifier: example.inspection-safe
                    version: "1.0.0"
                    content_digest: CONTENT_DIGEST
                  source_media_type: application/vnd.determa.inspection-fixture+json
                  source_digest: SOURCE_DIGEST
                  dependencies: []
                  capabilities:
                    deterministic: true
                    pure: true
                    portable: false
                    semantically_introspectable: true
                    process_contained: true
                    external_io_capable: false
                  input_types:
                    event: event_envelope
                    variables: typed_variables
                  output_type: bool
            unsafe:
              guard:
                provider:
                  provider_reference:
                    identifier: example.inspection-unsafe
                    version: "1.0.0"
                    content_digest: CONTENT_DIGEST
                  source_media_type: application/vnd.determa.inspection-fixture+json
                  source_digest: SOURCE_DIGEST
                  dependencies: []
                  capabilities:
                    deterministic: false
                    pure: false
                    portable: false
                    semantically_introspectable: false
                    process_contained: false
                    external_io_capable: true
                  input_types:
                    event: event_envelope
                    variables: typed_variables
                  output_type: bool
            mixed:
              - { guard: "true" }
              - guard:
                  provider:
                    provider_reference:
                      identifier: example.inspection-unsafe
                      version: "1.0.0"
                      content_digest: CONTENT_DIGEST
                    source_media_type: application/vnd.determa.inspection-fixture+json
                    source_digest: SOURCE_DIGEST
                    dependencies: []
                    capabilities:
                      deterministic: false
                      pure: false
                      portable: false
                      semantically_introspectable: false
                      process_contained: false
                      external_io_capable: true
                    input_types:
                      event: event_envelope
                      variables: typed_variables
                    output_type: bool
